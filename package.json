{
  "name": "win98-web",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run build:registry && bun --bun vite build",
    "build:registry": "bun scripts/generate_registry.js",
    "preview": "bun --bun vite preview",
    "test": "bun x playwright test",
    "electron:dev": "concurrently \"cross-env ELECTRON_BUILD=true bun run dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "electron .",
    "package": "cross-env ELECTRON_BUILD=true electron-forge package",
    "make": "cross-env ELECTRON_BUILD=true electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-store": "^8.2.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "@zenfs/archives": "^1.3.1",
    "@zenfs/core": "^2.5.0",
    "@zenfs/dom": "^1.2.7",
    "@zenfs/emscripten": "^1.0.5",
    "ani-cursor": "^0.0.5",
    "html2canvas": "^1.4.1",
    "music-metadata-browser": "^2.5.11",
    "os-gui": "^0.7.3"
  }
}
